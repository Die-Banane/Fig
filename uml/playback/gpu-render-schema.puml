@startuml
title GPU rendering: preview and export share one renderer

package "Fig.Core (no UI, no Skia)" {
  class RenderScene {
    +Width: int
    +Height: int
    +Layers: RenderLayer[]
  }
  class RenderLayer {
    +Source: RenderSource
    +Incoming: RenderSource?
    +TransitionTypeId: string?
    +Progress: double
    +Effects: EffectCall[]
    +Opacity: double
  }
  class RenderSource {
    +Frame: DecodedFrame
    +Effects: EffectCall[]
    +Crop: CropInsets
  }
  class EffectCall {
    +TypeId: string
    +Params: ParamValue map (keyframes sampled)
  }
  interface ISceneRenderer {
    +Render(scene, canvas: byte[])
  }
  class CpuSceneRenderer {
    EffectPipeline + transition blenders + FrameCompositor
  }
  class "MediaService.BuildScene" as SceneBuilder {
    decodes the layers at t and resolves effects
  }
  class GraphPlan
  class EffectGraph
}

package "Fig.App.Rendering (Skia)" {
  class GpuSceneRenderer {
    +Render(canvas, GpuScene, dest)
  }
  class SkiaSceneRenderer
  class GpuEffects {
    SkSL shader per effect and transition
  }
  class GpuGraphRunner {
    +Build(plan, params, source): SKShader
  }
  class ShaderScope {
    +Materialize(shader): SKShader
  }
  interface IGpuJobRunner {
    +Run(job(GRContext?)): Task
  }
  class GpuJobHost {
    runs jobs on the compositor thread
  }
}

RenderScene *-- RenderLayer
RenderLayer *-- RenderSource
RenderSource *-- EffectCall
SceneBuilder ..> RenderScene : creates
CpuSceneRenderer ..|> ISceneRenderer
SkiaSceneRenderer ..|> ISceneRenderer
SkiaSceneRenderer --> GpuSceneRenderer
SkiaSceneRenderer --> IGpuJobRunner : export (GPU context)
GpuJobHost ..|> IGpuJobRunner
GpuSceneRenderer --> GpuEffects
GpuSceneRenderer --> ShaderScope
GpuEffects --> GpuGraphRunner : graph:<id> effects
GpuGraphRunner --> GraphPlan : walks steps
GraphPlan --> EffectGraph
@enduml
