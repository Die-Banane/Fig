@startuml
title GPU rendering: one frame of a graph effect, and export

actor User
participant MediaService as Export
participant "BuildScene" as SceneBuilder
participant ISceneRenderer as Renderer
participant GpuJobHost
participant GpuSceneRenderer
participant GpuEffects
participant GpuGraphRunner
participant "GPU (Skia)" as GPU

== Export ==
User -> Export : Export
loop every frame
  Export -> SceneBuilder : Build(timeline, t)
  SceneBuilder --> Export : RenderScene (decoded frames + effect calls)
  Export -> Renderer : Render(scene, canvas)
  alt GPU available
    Renderer -> GpuJobHost : submit job
    GpuJobHost -> GpuSceneRenderer : Render(scene) on compositor thread
  else no GPU
    Renderer -> Renderer : CpuSceneRenderer (same scene)
  end
  GpuSceneRenderer --> Export : BGRA pixels
end

== One layer ==
GpuSceneRenderer -> GpuEffects : Apply(shader, EffectCall)
alt stock effect
  GpuEffects --> GpuSceneRenderer : SkSL shader wrapping input
else graph:<id>
  GpuEffects -> GpuGraphRunner : Build(plan, promoted params)
  loop plan steps
    GpuGraphRunner -> GpuEffects : primitive shader (inputs are shaders)
    opt output read more than once or multi-pass
      GpuGraphRunner -> GPU : Materialize (offscreen pass)
    end
  end
  GpuGraphRunner --> GpuEffects : output shader
end
GpuSceneRenderer -> GPU : draw one quad with the final shader
@enduml
