@startuml
title Fig template system

skinparam backgroundColor #18191b
skinparam defaultFontColor #e6e7e9
skinparam classBackgroundColor #232529
skinparam classBorderColor #4b5059
skinparam arrowColor #89919e
skinparam packageBorderColor #3b4048

package "Fig.Core.Templates" {
  class VideoTemplate {
    +Id: string
    +Name: string
    +Description: string
    +Category: string
    +Tags: List<string>
    +CanvasWidth: int
    +CanvasHeight: int
    +Timeline: Timeline
    +Slots: List<TemplateSlot>
  }

  class TemplateSlot {
    +Id: string
    +Name: string
    +Kind: MediaKind
    +TargetDurationSec: double
    +Required: bool
  }

  class TemplateBuilder {
    +FromTimeline(name, category, timeline, media): VideoTemplate
  }

  class TemplateInstantiator {
    +Instantiate(template, assignments): Timeline
    +ValidateAssignments(template, assignments): IReadOnlyList<string>
  }

  class TemplateStore {
    +List(): IReadOnlyList<VideoTemplate>
    +Save(template): void
    +Load(id): VideoTemplate?
  }
}

package "Existing editor domain" {
  class Timeline
  class Clip
  class MediaAsset
  class TimelineEditor
}

package "Fig.App" {
  class EditorViewModel {
    +Templates: ObservableCollection<VideoTemplate>
    +CreateTemplateCommand
    +UseTemplateCommand
  }
  class EditorView
  class PropertiesViewModel
}

VideoTemplate "1" *-- "1..*" TemplateSlot
VideoTemplate "1" *-- "1" Timeline : blueprint
Timeline "1" *-- "0..*" Clip
TemplateBuilder ..> Timeline
TemplateBuilder ..> MediaAsset
TemplateBuilder ..> VideoTemplate
TemplateInstantiator ..> VideoTemplate
TemplateInstantiator ..> MediaAsset : slot assignment
TemplateInstantiator ..> Timeline : fresh instance
TemplateStore ..> VideoTemplate : JSON persistence
EditorViewModel --> TemplateStore
EditorViewModel --> TemplateBuilder
EditorViewModel --> TemplateInstantiator
EditorViewModel --> TimelineEditor
EditorView --> EditorViewModel
EditorView --> PropertiesViewModel : persistent inspector

note right of TemplateSlot
  Timeline blueprint media clips use
  template slot IDs as SourceId values.
  Instantiation replaces them with
  project MediaAsset IDs.
end note

note bottom of EditorView
  Workspace columns remain mounted:
  Library | Canvas | Inspector
  Selection changes content, not layout.
end note
@enduml
