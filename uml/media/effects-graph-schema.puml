@startuml
' fig Effect graphs: user-built effects composed from primitive nodes, saved as catalog effects.
' Design rule: a graph effect is just another catalog entry. It reuses EffectInstance, ParamDef,
' keyframes, presets and the effect stack unchanged; only the processor behind the typeId differs.

package "Timeline (saved in the project file)" {

  class EffectInstance <<existing>> {
    typeId : string          ' stock id, or "graph:<graphId>"
    params : map<string, ParamValue>
    keyframes : map<string, KeyframePoint[]>
  }

  class EffectGraph {
    * id : string
    --
    name : string
    schemaVersion : int
    updatedAt : datetime
    nodes : GraphNode[]
    edges : GraphEdge[]
    promoted : PromotedParam[]
    + typeId : "graph:" + id
    + Clone()
  }

  class GraphNode {
    * id : string
    --
    primitiveId : string      ' "blur", "mix", "uv-offset", "effect", "output" ...
    effectTypeId : string?    ' only for primitive "effect": the wrapped stock effect
    params : map<string, ParamValue>
    bypass : bool
    x, y : double             ' editor position only; rendering never reads it
  }

  class GraphEdge {
    fromNodeId, fromPort : string
    toNodeId, toPort : string
  }

  class PromotedParam {
    key : string               ' becomes the effect's ParamDef.key
    label : string
    targets : PromotedTarget[] ' one control may drive several node params
    min / max / default : double?   ' optional overrides of the first target
  }

  class PromotedTarget {
    nodeId, param : string
    scale : double = 1         ' -1 drives a node the opposite way
  }

  class Project <<existing>> {
    effectGraphs : EffectGraph[]
  }

  enum GraphPortType {
    Image
    Mask
  }

  Project "1" *-- "0..*" EffectGraph
  EffectGraph "1" *-- "1..*" GraphNode
  EffectGraph "1" *-- "0..*" GraphEdge
  EffectGraph "1" *-- "0..*" PromotedParam : "exposed sliders"
  PromotedParam "1" *-- "1..*" PromotedTarget
  PromotedTarget ..> GraphNode : "one param"
  EffectInstance ..> EffectGraph : "typeId graph:<id>"
}

package "Media (core library)" {

  interface IGraphPrimitive {
    Evaluate(PrimitiveContext) : map<port, frame>
  }

  class PrimitiveContext {
    node / source frame / localT
    Input(port) / OptionalInput(port)
    Number / Int / Bool / Choice / Color(key)
  }

  class PrimitiveDescriptor {
    id / displayName / category / description
    inputs, outputs : PortDef[]
    paramSchema : ParamDef[]
  }

  class PortDef {
    id / label : string
    type : GraphPortType
    required : bool
  }

  class PrimitiveCatalog {
    {static} All / Find / Resolve
    {static} ParamSchemaFor(node)
  }

  class StockEffectPrimitive {
    ' primitive "effect": runs any built-in IEffectProcessor
  }

  class GraphCompiler {
    {static} Compile(EffectGraph) : CompileResult
  }

  class CompileResult {
    plan : GraphPlan?
    errors : GraphError[]
    unusedNodeIds : string[]
    isValid : bool
  }

  class GraphError {
    code : GraphErrorCode
    message : string
    nodeId : string?
  }

  class GraphPlan {
    steps : PlanStep[]        ' dependency order, output last
    consumers : (node, port) -> readers
  }

  class PlanStep {
    node / descriptor / primitive
    inputs : port -> (node, port)
    bypassed : bool
  }

  class GraphEffectProcessor {
    ' IEffectProcessor bound to one EffectGraph
    compile : CompileResult
    + Apply(frame, params, localT) : frame
  }

  class GraphEffectLibrary {
    graphs : EffectGraph[]    ' the project's own list
    + Attach(list) / Detach()
    + Save(graph) : CompileResult
    + Delete(id) / Duplicate(id)
    + Export(id, path) / Import(path)
    {static} BuildEntry(graph) : EffectCatalogEntry
  }

  interface IEffectProcessor <<existing>>
  class EffectCatalog <<existing>> {
    All / Find / Resolve
    + SetUserEffects(owner, entries)
    + ClearUserEffects(owner)
  }
  class EffectCatalogEntry <<existing>> {
    isCustom : bool
    paramSchema : ParamDef[]   ' built from the promoted controls
  }

  IGraphPrimitive <|.. StockEffectPrimitive
  PrimitiveCatalog ..> IGraphPrimitive : "discovers [Primitive]"
  PrimitiveCatalog --> PrimitiveDescriptor
  PrimitiveDescriptor *-- PortDef
  PortDef --> GraphPortType
  IGraphPrimitive ..> PrimitiveContext

  GraphCompiler ..> EffectGraph : "reads"
  GraphCompiler --> PrimitiveCatalog
  GraphCompiler --> CompileResult
  CompileResult o-- GraphPlan
  CompileResult o-- GraphError
  GraphPlan *-- PlanStep

  IEffectProcessor <|.. GraphEffectProcessor
  GraphEffectProcessor --> GraphCompiler : "compiles once"
  GraphEffectProcessor --> GraphPlan : "executes"
  GraphEffectLibrary --> GraphCompiler : "validates on save"
  GraphEffectLibrary --> GraphEffectProcessor : "creates"
  GraphEffectLibrary --> EffectCatalogEntry : "publishes"
  GraphEffectLibrary --> EffectCatalog : "SetUserEffects"
}

package "Editor (app)" {

  class GraphEditorViewModel {
    graph : EffectGraph       ' working copy
    selection : nodes / edge
    isValid / isDirty / problems
    beforeImage / afterImage
    nodeParams, exposed : rows
    + AddNode / InsertOnEdge / Connect(why not?)
    + Disconnect / MoveNodes / DeleteSelection
    + ToggleBypass / Copy / Paste / Duplicate
    + TogglePromote / PromoteAll / rename / move / remove control
    + Undo / Redo / Revert / Save / Back
  }

  class GraphCanvas <<Avalonia>> {
    pan / zoom, nodes, wires, ports, pins
    marquee, wire dragging, context menus
  }

  class GraphEditorView <<Avalonia>> {
    top bar (Add / Edit / View, icons)
    inspector, quick search
  }

  class SplitPreview <<Avalonia>>

  class EditorViewModel <<existing>> {
    effectGraphs : GraphEffectLibrary
    graphEditor : GraphEditorViewModel?
    + NewGraphEffect / EditGraphEffect
  }

  EditorViewModel --> GraphEffectLibrary
  EditorViewModel --> GraphEditorViewModel : "opens"
  GraphEditorViewModel --> EffectGraph : "edits a copy"
  GraphEditorViewModel --> GraphEffectProcessor : "validate + preview"
  GraphEditorViewModel --> GraphEffectLibrary : "Save"
  GraphEditorView --> GraphCanvas
  GraphEditorView --> SplitPreview
  GraphCanvas --> GraphEditorViewModel
}

note bottom of PromotedParam
  Promoted params are the saved effect's schema.
  Because they are ordinary ParamDefs, keyframes,
  presets and the properties panel work on them
  with no new code.
end note

note bottom of EffectGraph
  Acyclic by construction (no feedback in v1) and
  exactly one "output" node. Evaluation is a pure
  function of the frame, parameters and clip time,
  so scrubbing and export match.
end note

note bottom of GraphEffectLibrary
  Graphs live in the project file (self-contained);
  Export/Import move a graph between projects as
  a .figgraph.json file.
end note

@enduml
