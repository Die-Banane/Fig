@startuml
' fig Effect graphs: how a graph effect renders (preview + export) and how it is saved.
skinparam sequenceMessageAlign left

participant "EffectPipeline" as P
participant "EffectCatalog" as C
participant "GraphEffectProcessor" as G
participant "GraphPlan" as Plan
participant "IGraphPrimitive" as Prim
participant "FramePool" as Pool

== Render a clip or track frame ==
P -> P : ResolveParams(fx, localT)\n(keyframes; promoted controls included)
P -> C : Resolve("graph:<id>")
C --> P : GraphEffectProcessor
P -> G : Apply(frame, params, localT)

alt graph did not compile
  G --> P : input frame unchanged\n(the clip shows its original picture)
else plan valid
  G -> G : overrides = promoted control values\n(scaled per target) by node
  loop each step in dependency order
    G -> Prim : Evaluate(PrimitiveContext)\n(inputs, node params + overrides, localT)
    Prim -> Pool : Rent(output)
    Prim --> G : output frames by port
    G -> Pool : Return(inputs with no readers left)
  end
  note right of G
    Reference counts per buffer handle
    pass-through primitives. The source
    frame is never returned from here.
  end note
  alt a primitive throws
    G -> Pool : Return(everything rented)
    G --> P : input frame unchanged
  else
    G --> P : output frame (pooled, owned by the caller)
  end
end

== Save in the editor ==
actor User
participant "GraphEditorViewModel" as VM
participant "GraphCompiler" as K
participant "GraphEffectLibrary" as Lib

User -> VM : edit nodes, wires, pins
VM -> K : Compile(working copy)\nafter every edit
K --> VM : CompileResult\n(errors on nodes, unused nodes)
VM -> VM : render preview with a\nGraphEffectProcessor
User -> VM : Save
VM -> Lib : Save(graph)
Lib -> K : Compile(graph)
alt errors
  Lib --> VM : CompileResult (not stored)
  VM --> User : "Fix the problems before saving"
else valid
  Lib -> Lib : store a copy in the project's list
  Lib -> C : SetUserEffects(owner, entries)\n(promoted controls become the ParamDefs)
  C --> User : effect appears under "My effects",\nusable on clips, keyframable, presettable
end

note over Lib, C
  Planned, not built: fusing graphs made of
  shader-capable primitives into one GPU shader.
  Graph effects currently run on the CPU path.
end note

@enduml
