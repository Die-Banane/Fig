@startuml
title Preferences: load, read, change

participant App
participant PreferenceService as Service
participant PreferenceLoader as Loader
participant "Editor / Timeline" as Caller

== startup ==
App -> Loader : new PreferenceLoader(AppPaths.PreferencesPath)
App -> Service : new PreferenceService(loader)
Service -> Loader : Load()
alt file missing
  Loader --> Service : new Preferences()
else file damaged
  Loader -> Loader : rename to preferences.json.bad
  Loader --> Service : new Preferences()
else
  Loader --> Service : deserialized Preferences
end
Service -> Service : Current.Normalize()

== read ==
Caller -> Service : Current.Editing.SnapReachPx
Service --> Caller : 9

== change from the Preferences page ==
actor User
participant "EditingPageViewModel" as Page
User -> App : File > Preferences (Ctrl+,)
App -> Page : new PreferencesViewModel(service)
User -> Page : SnapReachPx = 14
Page -> Service : Current.Editing.SnapReachPx = 14
Page -> Service : Save()
Service -> Service : Current.Normalize()
Service -> Loader : Save(Current)
Service -> Caller : Changed
Caller -> Service : re-read what it holds (e.g. Snap)

== change from the editor (a toolbar toggle) ==
Caller -> Service : Current.Editing.Snap = false
Caller -> Service : Save()
Service -> Page : Changed (an open page re-reads)
@enduml
