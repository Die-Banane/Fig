@startuml
title Preferences
skinparam classAttributeIconSize 0
hide empty members

class Preferences {
  + SchemaVersion : int
  + General : GeneralPreferences
  + Editing : EditingPreferences
  + Playback : PlaybackPreferences
  + Export : ExportPreferences
  + Rendering : RenderingPreferences
  + Keyboard : KeyboardPreferences
  + Unknown : Dictionary<string, JsonElement>?
  + Normalize() : void
}

class GeneralPreferences {
  + AutosaveSeconds : double = 0.8
  + AskBeforeClosingUnsaved : bool = true
}

class EditingPreferences {
  + Snap : bool = true
  + SnapReachPx : double = 9
  + LinkedSelection : bool = true
  + UndoSteps : int = 100
}

class PlaybackPreferences {
  + AudioScrub : bool = true
  + Loop : bool = false
}

class ExportPreferences {
  + Quality : int = 23
  + Folder : string?
}

enum RendererChoice {
  Automatic
  Gpu
  Cpu
}

class RenderingPreferences {
  + Renderer : RendererChoice = Automatic
}

class KeyboardPreferences {
  + Shortcuts : Dictionary<string, string>
  (action id -> gesture; only changed ones; "" = none)
}

class ShortcutAction <<record>> {
  + Id : string
  + Section : string
  + Label : string
  + DefaultGesture : string
  + Command : Func<AppViewModel, ICommand?>
}

class ShortcutCatalog <<static>> {
  + All : IReadOnlyList<ShortcutAction>
  + GestureFor(prefs : Preferences, action : ShortcutAction) : string
}

class PreferenceService {
  - _loader : PreferenceLoader
  + Current : Preferences
  + Changed : event Action
  + PreferenceService()
  + PreferenceService(loader : PreferenceLoader)
  + Save() : void
}

class RenderingPageViewModel {
  + Renderer : RendererChoice
  + CanvasStatus : string
}

class KeyboardPageViewModel {
  + Rows : ShortcutRowViewModel[]
}

class ShortcutRowViewModel {
  + Label : string
  + Gesture : string
  + IsRecording : bool
  + Conflict : string?
  + Record() : void
  + Assign(gesture : KeyGesture) : void
  + Clear() : void
  + Reset() : void
}

class StoragePageViewModel {
  + Folders : StorageRow[]
  + CacheSize : string
  + ClearCache() : void
}

class StorageRow {
  + Label : string
  + Path : string
  + Size : string
  + Open() : void
}

class MainWindow {
  - ApplyShortcuts() : void
}

class PreferencesViewModel {
  + Pages : PreferencePageViewModel[]
  + SelectedPage : PreferencePageViewModel
  + Close() : void
}

abstract class PreferencePageViewModel {
  # Service : PreferenceService
  + Title : string
  + Icon : string
  + ResetToDefaults() : void
  # Apply(change : Action<Preferences>) : void
}

class GeneralPageViewModel {
  + AutosaveSeconds : double
  + AskBeforeClosingUnsaved : bool
}

class EditingPageViewModel {
  + Snap : bool
  + SnapReachPx : double
  + LinkedSelection : bool
  + UndoSteps : int
}

class PlaybackPageViewModel {
  + AudioScrub : bool
  + Loop : bool
}

class ExportPageViewModel {
  + Quality : int
  + Folder : string
}

class RenderingPageViewModel {
  + Renderer : RendererChoice
  + CanvasStatus : string
}

class KeyboardPageViewModel {
  + Rows : ShortcutRowViewModel[]
}

class ShortcutRowViewModel {
  + Label : string
  + Gesture : string
  + IsRecording : bool
  + Conflict : string?
  + Record() : void
  + Assign(gesture : KeyGesture) : void
  + Clear() : void
  + Reset() : void
}

class StoragePageViewModel {
  + Folders : StorageRow[]
  + CacheSize : string
  + ClearCache() : void
}

class StorageRow {
  + Label : string
  + Path : string
  + Size : string
  + Open() : void
}

class MainWindow {
  - ApplyShortcuts() : void
}

class PreferencesView
class AppViewModel {
  + Preferences : PreferenceService
  + PreferencesPage : PreferencesViewModel?
  + OpenPreferences() : void
}
class EditorViewModel {
  + Preferences : PreferenceService
}

class PreferenceLoader {
  - _path : string
  + PreferenceLoader(path : string)
  + Load() : Preferences
  + Save(preferences : Preferences) : void
}

Preferences *-- GeneralPreferences
Preferences *-- EditingPreferences
Preferences *-- PlaybackPreferences
Preferences *-- ExportPreferences
Preferences *-- RenderingPreferences
Preferences *-- KeyboardPreferences
RenderingPreferences --> RendererChoice
ShortcutCatalog o-- "*" ShortcutAction
ShortcutCatalog ..> KeyboardPreferences : overrides
PreferenceService *-- Preferences
PreferenceService --> PreferenceLoader
PreferencesViewModel *-- PreferencePageViewModel
PreferencePageViewModel <|-- GeneralPageViewModel
PreferencePageViewModel <|-- EditingPageViewModel
PreferencePageViewModel <|-- PlaybackPageViewModel
PreferencePageViewModel <|-- ExportPageViewModel
PreferencePageViewModel <|-- RenderingPageViewModel
PreferencePageViewModel <|-- KeyboardPageViewModel
PreferencePageViewModel <|-- StoragePageViewModel
KeyboardPageViewModel *-- ShortcutRowViewModel
KeyboardPageViewModel ..> ShortcutCatalog
StoragePageViewModel *-- StorageRow
MainWindow ..> ShortcutCatalog : builds key bindings
PreferencePageViewModel --> PreferenceService
PreferencesView ..> PreferencesViewModel : binds
AppViewModel --> PreferenceService
AppViewModel --> PreferencesViewModel : opens
EditorViewModel --> PreferenceService
@enduml
