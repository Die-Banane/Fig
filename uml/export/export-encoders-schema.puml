@startuml
title Export: frame-accurate rate, and the encoder (GPU when there is one)

package "Fig.Core.Media.Rendering" {
  enum VideoEncoderChoice <<new>> {
    Automatic
    Nvenc
    QuickSync
    Amf
    Vaapi
    Software
  }
  class VideoEncoders <<static, new>> {
    +Candidates(choice): list of encoder names
    +Open(choice, width, height, rate, crf): OpenedEncoder
    --
    Automatic tries h264_nvenc, h264_qsv, h264_amf,
    h264_vaapi, then libx264; a named choice tries that
    one, then libx264. The first that opens wins.
    Quality (the dialog's CRF 0..51) maps per encoder:
      libx264 crf · nvenc cq (vbr, p5) · qsv global_quality
      amf cqp qp_i/qp_p · vaapi CQP qp
  }
  class OpenedEncoder <<new>> {
    +Context: AVCodecContext*
    +Name: "h264_nvenc"...
    +InputFormat: yuv420p or nv12
    +HwFrames: AVBufferRef* (VA-API only)
    +Label: "NVIDIA NVENC"...
    --
    VA-API takes GPU frames: each frame is uploaded
    (av_hwframe_transfer_data) before it is sent.
  }
  class TimelineRender {
    +RenderTimeline(..., encoder, encoderUsed)  <<changed>>
    --
    the stream runs on the timeline's exact rate
    (time base Den/Num, e.g. 1001/30000): frame f is at
    start + f x Den / Num, so 29.97 stays 29.97
    (it was rounded to 30 and drifted 3.6 s an hour)
  }
}

package "Fig.App" {
  class ExportPreferences {
    +Encoder: VideoEncoderChoice  <<new>>
  }
  class ExportDialogViewModel {
    +Encoders, EncoderIndex  <<new>>
  }
  class ExportJob {
    +EncoderName  <<new>>: shown with its size and rate
  }
}

TimelineRender ..> VideoEncoders : Open
VideoEncoders ..> OpenedEncoder
VideoEncoders ..> VideoEncoderChoice
ExportDialogViewModel ..> ExportPreferences
ExportDialogViewModel ..> VideoEncoderChoice
ExportJob ..> TimelineRender : encoderUsed
@enduml
