@startuml
title Selection: everything selectable is one thing

package "Fig.Core.Timeline" {
  enum Facet <<flags>> {
    Picture   (opacity)
    Crop      (shown in the Picture tab)
    Layout    (position, scale, rotation)
    Sound     (volume)
    Fades
    Retime    (speed)
    Effects   (the stack and its parameters)
    Source    (the media file)
    Text      (text and its style)
    Track
    Marker
    Transition
  }
  enum SelectionGroup {
    Clip
    Track
    Marker
    Transition
    Effect
  }
  class SelectionKey <<record>> {
    +Group: SelectionGroup
    +Id: string
    +OwnerId: string?
  }
  interface ISelectable {
    +Key: SelectionKey
    +DisplayName: string
    +Facets: Facet
  }
  abstract class Clip
  class VideoClip
  class AudioClip
  class TextClip
  class ImageClip
  class Track
  class Marker
  class CutTransition
  class EffectTarget {
    owner + effect (a bar on the timeline)
  }
  class SelectionState {
    -items: SelectionKey[] (one ordered list, any mix of groups)
    +Items
    +Replace(keys) / Add / Toggle / Remove / Clear
    +SetGroup(group, keys)  (change one group, keep the rest)
    +Changed
  }
  class TimelineEditor {
    +Selection: SelectionState
    +Resolve(key): ISelectable?
    +Selected: ISelectable[]
    +SelectAll()
    +DeleteSelection()  (group by group, one undo step)
    +EditTargets(ids, facet): ids
    +SetClipValue(ids, property, value)
  }
}

package "Fig.App.ViewModels" {
  class PropertiesViewModel {
    +Sections: InspectorSection[]
    +OpenSection(facet)
    +Refresh(selected)
    edits reach every selected item
    with the facet, as one undo step
  }
  abstract class InspectorSection {
    +Facet
    +Title
    +Icon
  }
  class SectionRegistry {
    Facet -> section factory
  }
}

ISelectable <|.. Clip
Clip <|-- VideoClip
Clip <|-- AudioClip
Clip <|-- TextClip
Clip <|-- ImageClip
ISelectable <|.. Track
ISelectable <|.. Marker
ISelectable <|.. CutTransition
ISelectable <|.. EffectTarget
ISelectable --> Facet
ISelectable --> SelectionKey
SelectionKey --> SelectionGroup
SelectionState o-- SelectionKey
TimelineEditor *-- SelectionState
TimelineEditor ..> ISelectable : resolves keys
PropertiesViewModel ..> TimelineEditor : SetClipValue
PropertiesViewModel --> SectionRegistry
PropertiesViewModel *-- InspectorSection
SectionRegistry ..> InspectorSection : creates
@enduml
