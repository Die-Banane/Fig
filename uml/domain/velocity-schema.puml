@startuml
title Velocity edits (Vegas model): a speed curve on the clip; the clip keeps its length

package "Fig.Core.Timeline" {
  abstract class Clip {
    +StartSec, DurSec, Speed
    +SrcInSec, SrcOutSec
    +Keyframes["speed"]: list of KeyframePoint  <<new key>>
    --
    "speed" keyframes: clip-local timeline seconds -> speed (0.1x..8x),
    each eased into the next (Linear, EaseIn, EaseOut, EaseInOut, Hold).
    No "speed" keys: the clip plays at Speed, as before.
    SrcOutSec = SourceAt(DurSec): how much footage the curve uses.
  }
  class VideoClip {
    +BlendFrames: bool  <<new>>
    +MotionBlur: 0..1  <<new>>
    --
    smoothing for the speed at each moment:
    span = ClipTime.SpanAt(clip, t, 1 / project fps)
    span < one file frame and BlendFrames: mix the two real frames around t
    span > one file frame and MotionBlur: average the frames the step passed
  }
  class "VideoFrameSource" as VFS {
    +DecodeSmoothed(t, span, blend, motionBlur, mode)  <<new>>
    --
    blend: the frame shown before is kept (two buffers swap, no copy)
    blur: frames from t - span x MotionBlur are scaled and summed
    scrub: always the plain frame
  }
  VideoClip --|> Clip
  VFS ..> VideoClip

  class AutomationKeys {
    +Speed = "speed"  <<new>>
  }
  class ClipTime <<static, new>> {
    +HasCurve(clip): bool
    +SpeedAt(clip, t): double
    +SourceAt(clip, t): double
    +LocalAt(clip, sourceSec): double
    +DurationFor(clip, sourceSpan): double
    +SplitKeyframes(left, right, offset)
    +TrimStart(clip, originalSpeedKeys, originalSrcIn, delta)
    --
    The one place timeline time becomes file time.
    SourceAt = SrcIn + area under the speed curve from 0 to t,
    closed form per eased segment (no sampling).
    Outside the keys the speed holds the first or last value,
    so transitions reaching past an edge keep working.
    LocalAt inverts it (speed > 0, so it is monotonic).
  }
  class SetSpeedCurveCommand <<command, coalescing, new>> {
    old keys + SrcOut -> new keys, SrcOut = SourceAt(DurSec)
    --
    null keys removes the curve
  }
  class TimelineEditor {
    +SetSpeedCurve(clipId, keys, gesture)  <<new>>
    +AddSpeedCurve(clipId) / RemoveSpeedCurve(clipId)  <<new>>
    +SetSpeed(clipId, speed)  <<changed: ignored while a curve exists>>
  }
  class ClipGeometry <<record struct, changed>> {
    +SpeedKeys  <<new>>
    --
    a live trim also reshapes the curve, so undo restores it
  }
}

package "Callers (all switch from x Speed to ClipTime)" {
  class TimelineRender
  class PreviewViewModel
  class EditorViewModel
  class AudioMixer {
    varispeed: each output sample reads the source at SourceAt(t),
    so the pitch follows the curve
  }
  class CutCommand
  class OverwriteInsertCommand
  class RippleInsertCommand
  class TrimCommand
  class "TimelineView (filmstrip, live trim)" as TV
  class BeatMarkersViewModel
  class ProjectManager
}

package "Fig.App" {
  class "TimelineView.Velocity" as TVV <<new>> {
    draws the speed line over the picture (log scale, 1x in the middle)
    drag a point: up faster, down slower; sideways snaps to beats
    double-click the line: add a point
    right-click a point: easing, delete
    clip menu: Add speed curve / Remove speed curve
  }
}

Clip --> AutomationKeys
ClipTime ..> Clip
TimelineEditor ..> SetSpeedCurveCommand
SetSpeedCurveCommand ..> ClipTime
TVV ..> TimelineEditor : SetSpeedCurve
TVV ..> ClipTime : SpeedAt
TimelineRender ..> ClipTime
PreviewViewModel ..> ClipTime
EditorViewModel ..> ClipTime
AudioMixer ..> ClipTime
CutCommand ..> ClipTime
OverwriteInsertCommand ..> ClipTime
RippleInsertCommand ..> ClipTime
TrimCommand ..> ClipTime
TV ..> ClipTime
BeatMarkersViewModel ..> ClipTime
ProjectManager ..> ClipTime
@enduml
