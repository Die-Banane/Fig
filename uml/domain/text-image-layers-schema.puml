@startuml
title Text and image layers

package "Fig.Core.Timeline" {
  abstract class Clip {
    +Facets: Facet
    +HasSourceRange: bool
    +Clone(): Clip
  }
  interface ILayerClip {
    +Layout: LayerTransform
  }
  interface ICroppable {
    +CropL, CropT, CropR, CropB
  }
  class VideoClip
  class ImageClip {
    +SourceId: string  (a MediaAsset of kind Image: a still,
     or an animated GIF / WebP that loops)
    +Facets = Picture | Crop | Layout | Fades | Effects | Source
    default length 5 s, no retime
  }
  class TextClip {
    +Text: string
    +Style: TextStyle
    +Facets = Text | Picture | Layout | Fades | Effects
    default length 3 s
  }
  class TextStyle <<record>> {
    +FontFamily, Bold, Italic
    +SizePercent  (of the frame height)
    +Color, Align
    +Shadow, Background, BackgroundColor
  }
  class LayerTransform <<record>> {
    +CenterX, CenterY  (0..1 of the frame)
    +Scale, Rotation
  }
  class TextPreset <<record>> {
    +Name, Text, Style, Layout, DurSec
  }
  class TimelineEditor {
    +AddText(track, start, preset): TextClip
    +SetClipValue(ids, property, get, set, value)
    +EditTargets(ids, facet): ids
  }
  class AddClipCommand
  class SetClipValueCommand<T>
}

package "Fig.Core.Media.Rendering" {
  class RenderSource {
    +Frame: DecodedFrame
    +HasAlpha: bool
  }
  interface ILayerRasterizer {
    +Rasterize(clip, width, height, t): DecodedFrame
  }
  class CpuSceneRenderer {
    premultiplied "over" when HasAlpha
  }
}

package "Fig.App.Rendering" {
  class SkiaLayerRasterizer {
    text: TextLayout; image: decoded still
    cache by (content, style, layout, size)
  }
  class LayerImage {
    every frame decoded by SKCodec, each composed
    over the frame it builds on; alpha kept
    +FrameAt(t): the frame at t, looping
  }
  class TextLayout {
    lines -> runs of one font each
    (fallback per grapheme; emoji -> colour emoji font)
    each run shaped by HarfBuzz (SKShaper)
  }
  class GpuSceneRenderer {
    decal sampling, alpha kept, when HasAlpha
  }
}

package "Fig.App.ViewModels" {
  class TextSection {
    text, font, bold, italic, size,
    colour, alignment, shadow, background
  }
  class LayoutSection {
    X, Y, scale, rotation
  }
  class PropertiesViewModel {
    edits reach every selected clip
    with the facet, as one undo step
  }
}

Clip <|-- VideoClip
Clip <|-- ImageClip
Clip <|-- TextClip
ICroppable <|.. VideoClip
ICroppable <|.. ImageClip
ILayerClip <|.. ImageClip
ILayerClip <|.. TextClip
TextClip *-- TextStyle
ILayerClip *-- LayerTransform
TextPreset ..> TextStyle
TimelineEditor ..> TextPreset
TimelineEditor ..> AddClipCommand : one undo step
TimelineEditor ..> SetClipValueCommand
ILayerRasterizer <|.. SkiaLayerRasterizer
SkiaLayerRasterizer ..> TextLayout
SkiaLayerRasterizer ..> LayerImage
RenderSource ..> ILayerRasterizer : ILayerClip frames come from it
GpuSceneRenderer ..> RenderSource
CpuSceneRenderer ..> RenderSource
PropertiesViewModel *-- TextSection
PropertiesViewModel *-- LayoutSection
PropertiesViewModel ..> TimelineEditor : SetClipValue
@enduml
