@startuml
title Layer gizmos: move, scale and rotate text and images on the preview

package "Fig.Core.Media" {
  interface ILayerRasterizer {
    +Rasterize(clip, w, h, t): DecodedFrame?
    +Measure(clip, w, h): LayerSize?  <<new>>
    (unscaled content size, in frame pixels)
  }
  class LayerGeometry <<new, static>> {
    +Corners(layout, size): Point[4]  (0..1 frame units)
    +Contains(layout, size, point, aspect): bool
  }
}

package "Fig.Core.Timeline" {
  class LayerTransform <<record>> {
    +CenterX, CenterY, Scale, Rotation
  }
  class TimelineEditor {
    +SetLayouts(layouts by clip id)  <<new>>
    +LayerAt(t, x, y, aspect, measure): Clip?  <<new>>
  }
  class SetClipValueCommand<T> {
    one value per clip  <<changed>>
    coalesces a drag into one step
  }
  class CommandHistory {
    +BreakCoalescing()  <<new>>
    (each drag starts its own undo step)
  }
}

package "Fig.App.ViewModels" {
  class LayerGizmoViewModel <<new>> {
    +Items: GizmoItem[]  (the selected layers visible at the playhead)
    +ShowOverlay: bool
    +FrameAspect: double
    +Begin()
    +Pick(x, y, additive): bool
    +ItemAt(x, y): GizmoItem?  (hover)
    +Move(dx, dy, snap) / Scale(f) / Rotate(deg)
  }
  class GizmoItem <<record>> {
    +ClipId
    +Layout: LayerTransform
    +Width, Height  (unscaled, 0..1 of the frame)
    +IsPrimary
  }
  class PropertiesViewModel {
    +Layers: LayerGizmoViewModel
  }
}

package "Fig.App.Controls" {
  class LayerGizmo <<new>> {
    draws each item's rotated box;
    the primary gets corner (scale)
    and top (rotate) handles
    hit-tests only over layers and handles,
    so other clicks reach the preview
  }
}

PropertiesViewModel *-- LayerGizmoViewModel
LayerGizmoViewModel o-- GizmoItem
GizmoItem --> LayerTransform
LayerGizmo ..> LayerGizmoViewModel : DataContext
LayerGizmoViewModel ..> ILayerRasterizer : Measure
LayerGizmoViewModel ..> LayerGeometry : hit test
LayerGizmoViewModel ..> TimelineEditor : SetLayouts / LayerAt
TimelineEditor ..> SetClipValueCommand
TimelineEditor --> CommandHistory
@enduml
