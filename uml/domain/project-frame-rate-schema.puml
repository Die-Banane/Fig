@startuml
title Project frame rate: clips play in real time, the timeline rate is the frame grid

package "Fig.Core.Timeline" {
  class FrameRate <<struct>> {
    +Num, Den, Fps
    +Standard: 23.976, 24, 25, 29.97, 30, 50, 59.94, 60  <<new>>
    +Plausible(rate?): FrameRate?  <<new>>
    --
    Plausible: the nearest standard rate within 1%,
    else a whole rate from 10 to 120 fps, else none.
    WebM often reports junk (1000/1, 13698/457).
  }
  class "Timeline" as TL {
    +Rate: FrameRate
    +RateChosen: bool  <<new>>
    --
    Rate: the project frame rate. It sets the frame grid
    (snapping, timecode, frame stepping) and the export rate.
    It never changes how fast or how long a clip plays.
    RateChosen: the user picked it, so imports leave it alone.
  }
  abstract class Clip {
    +StartSec, DurSec, Speed
    +SourceRate: FrameRate?  <<changed>>
    --
    SourceRate: the file's own rate, for information only.
    Source time = SrcIn + (t - StartSec) x Speed
    (was x Speed x SourceRate / Rate).
  }
  class TimelineEditor {
    +SetRate(rate)  <<new>>
    -PreparePlacement(clip, asset)  <<changed>>
    --
    PreparePlacement: an empty timeline whose rate wasn't
    chosen takes the first media's plausible rate. The clip
    is as long as its file; nothing is scaled.
  }
  class SetTimelineRateCommand <<command>> {
    old Rate, RateChosen -> new rate, RateChosen = true
  }
}

package "Fig.Core.Project.Migrations" {
  class RealTimeMediaMigration <<new>> {
    +Version = 2
    +Migrate(project)
    --
    A clip saved with SourceRate != Rate was played at
    Speed x SourceRate / Rate: that factor moves into Speed,
    so nothing moves or sounds different.
  }
}

package "Fig.Core.Media" {
  class MediaService {
    +Probe(path)  <<changed>>
    --
    A file with no length in its header (a recorded WebM)
    is measured from its last packet.
  }
}

package "Fig.App" {
  class EditorView <<changed>> {
    frame rate picker beside the sequence name
  }
}

TL *-- FrameRate
Clip --> FrameRate : SourceRate
TimelineEditor --> TL
TimelineEditor ..> SetTimelineRateCommand : SetRate
TimelineEditor ..> FrameRate : Plausible
RealTimeMediaMigration ..> Clip : Speed
EditorView ..> TimelineEditor : SetRate
@enduml
