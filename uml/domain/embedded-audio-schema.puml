@startuml
title Embedded audio: a video's sound is part of its clip until it is detached

package "Fig.Core.Timeline" {
  abstract class Clip {
    +Volume, FadeInSec, FadeOutSec
    +Keyframes ("volume")
    +LinkGroupId
  }
  class VideoClip {
    +SourceId, SrcInSec, SrcOutSec
    +PlaysAudio: bool  <<new>>
    +AudioFadeInSec, AudioFadeOutSec  <<new>>
    +Facets: Sound only while PlaysAudio  <<changed>>
    --
    PlaysAudio: the file has sound and it hasn't been detached;
    the sound is drawn as a strip under the picture.
    AudioFade*: the sound's fades, apart from the picture's.
  }
  class AudioClip {
    +SourceId, SrcInSec, SrcOutSec
    (a separate sound: a music file, or audio detached from a video)
  }
  class TimelineEditor {
    +CreateClipFromAsset(asset): Clip  <<changed>>
    (a video with sound: one VideoClip, PlaysAudio = true, no linked AudioClip)
    +DetachAudio(videoClipIds): list of AudioClip  <<new>>
  }
  class DetachAudio <<command, composite>> {
    SetClipValueCommand<bool>(PlaysAudio = false)
    SetTrackListCommand (only when no audio track is free)
    AddClipCommand(new AudioClip)
  }
  enum FadeOf <<new>> {
    Picture
    Sound
  }
  class ClipFade <<static>> {
    +Get(clip, of) / Set(clip, of, in, out)  <<new>>
    +ApplyFadeIn/Out(clip, sec, of)  <<changed>>
    +EffectiveVolume(clip, t): sound fades  <<changed>>
    +ApplySplitLeft/Right: both fades of a video  <<changed>>
  }
  class TimelineGeometry <<static>> {
    +AudioStripHeight  <<new>>
    +BodyHeight(track)  <<changed>>
    (picture + strip when a video clip in the track plays audio)
  }
}

package "Fig.Core.Audio" {
  class AudioMixer {
    +Mix(timeline, start, dur)  <<changed>>
    (audio tracks' AudioClips, and video tracks' VideoClips that PlaysAudio)
  }
}

package "Fig.Core.Project" {
  class "Project" as FigProject {
    +FormatVersion: int  <<new>>
  }
  class EmbeddedAudioMigration <<new, static>> {
    +Migrate(project)  (format 0 to 1, in Project/Migrations)
    --
    a video clip and its linked audio clip with the same source and timing
    become one clip that PlaysAudio, the audio clip's fades as its sound fades;
    other video clips keep their sound off
  }
}

package "Fig.App.Views" {
  class TimelineView {
    draws the audio strip (waveform) under the picture  <<changed>>
    EdgeAt(clip, track, pos, out FadeOf): a fade on the strip is the sound's  <<changed>>
    right-click a video clip -> "Detach audio"  <<new>>
  }
}

Clip <|-- VideoClip
Clip <|-- AudioClip
TimelineEditor ..> DetachAudio : executes
DetachAudio ..> AudioClip : creates
AudioMixer ..> VideoClip : mixes its sound
AudioMixer ..> AudioClip
EmbeddedAudioMigration ..> FigProject : on load
TimelineView ..> TimelineGeometry
TimelineView ..> ClipFade : fade handles on the picture or the strip
ClipFade ..> FadeOf
TimelineView ..> TimelineEditor : DetachAudio
@enduml
