<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="FigCanvas">#17181A</SolidColorBrush>
    <SolidColorBrush x:Key="FigPanel">#1D1E20</SolidColorBrush>
    <SolidColorBrush x:Key="FigCard">#232427</SolidColorBrush>
    <SolidColorBrush x:Key="FigBorder">#3A3C42</SolidColorBrush>
    <SolidColorBrush x:Key="FigText">#F0F0F0</SolidColorBrush>
    <SolidColorBrush x:Key="FigMuted">#8A8A8A</SolidColorBrush>
    <SolidColorBrush x:Key="FigAccent">#5F9CF8</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource FigCanvas}"/><Setter Property="Foreground" Value="{DynamicResource FigText}"/></Style>
  <Style Selector="Button.fig">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/></ControlTemplate></Setter>
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="#2B2D31"/><Setter Property="BorderBrush" Value="#3A3C42"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#F0F0F0"/>
  </Style>
  <Style Selector="Button.fig.primary"><Setter Property="Background" Value="#29466E"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="Button.fig.ghost"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.fig.danger"><Setter Property="Background" Value="#3A1F22"/><Setter Property="BorderBrush" Value="#FF6B6B"/><Setter Property="Foreground" Value="#FF6B6B"/></Style>
  <Style Selector="Button.fig.compact"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/></Style>
  <Style Selector="Button.fig.icon"><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="7"/></Style>
  <Style Selector="Button.fig:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#333335"/></Style>
  <Style Selector="Button.fig.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#5F9CF8"/></Style>
  <Style Selector="Button.fig:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#3D3D40"/></Style>
  <Style Selector="Button.fig:focus-visible"><Setter Property="BorderBrush" Value="#91BAFF"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="Button.fig:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
  <Style Selector="TextBox.fig"><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#17181A"/><Setter Property="BorderBrush" Value="#3A3C42"/><Setter Property="CornerRadius" Value="4"/></Style>

  <Style Selector="ToggleButton.fig">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="#292B2E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#C8C8C8"/>
    <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/></ControlTemplate></Setter>
  </Style>
  <Style Selector="ToggleButton.fig:checked"><Setter Property="Background" Value="#29466E"/><Setter Property="Foreground" Value="#91BAFF"/></Style>
  <Style Selector="ToggleButton.fig:pointerover"><Setter Property="Background" Value="#333335"/></Style>
  <Style Selector="ToggleButton.fig.icon"><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="7"/></Style>
  <Style Selector="ComboBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#17181A"/><Setter Property="BorderBrush" Value="#3A3C42"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,4"/></Style>
  <Style Selector="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#17181A"/><Setter Property="BorderBrush" Value="#3A3C42"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="24"/><Setter Property="Background" Value="#17181A"/><Setter Property="BorderBrush" Value="#3A3C42"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="6,3"/></Style>
  <Style Selector="Expander"><Setter Property="Template"><ControlTemplate><StackPanel>
    <ToggleButton Classes="fig disclosure" HorizontalContentAlignment="Stretch" Background="Transparent" Padding="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Grid ColumnDefinitions="*,Auto"><ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/><TextBlock Grid.Column="1" Text="⌄" Foreground="#8A8A8A" Margin="8,0,0,0"/></Grid></ToggleButton>
    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{TemplateBinding IsExpanded}"/>
  </StackPanel></ControlTemplate></Setter></Style>
  <Style Selector="ToggleButton.fig /template/ ContentPresenter"><Setter Property="Background" Value="#292B2E"/><Setter Property="Foreground" Value="#C8C8C8"/></Style>
  <Style Selector="ToggleButton.fig:checked /template/ ContentPresenter"><Setter Property="Background" Value="#29466E"/><Setter Property="Foreground" Value="#91BAFF"/></Style>
  <Style Selector="ToggleButton.fig:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#333335"/></Style>
  <Style Selector="ToggleButton.fig.ghost /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="ToggleButton.fig.ghost:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#232427"/></Style>
  <Style Selector="ToggleButton.fig.disclosure /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="ToggleButton.fig.disclosure:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#232427"/></Style>
</Styles>
