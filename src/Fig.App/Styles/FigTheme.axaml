<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Fig's look: flat and soft. Surfaces are told apart by tone, not by outlines or shadows; corners are generous;
    text is never pure white. Every colour and radius lives here so a screen only names what it means.
  -->
  <Styles.Resources>
    <!-- surfaces, darkest to lightest -->
    <Color x:Key="SurfaceBgColor">#131417</Color>
    <SolidColorBrush x:Key="SurfaceBg" Color="#131417"/>
    <SolidColorBrush x:Key="PanelBg" Color="#1a1b1f"/>
    <SolidColorBrush x:Key="CardBg" Color="#212328"/>
    <SolidColorBrush x:Key="CardBgAlt" Color="#272a30"/>
    <SolidColorBrush x:Key="ChipBg" Color="#2a2d34"/>
    <SolidColorBrush x:Key="HoverBg" Color="#30343b"/>
    <SolidColorBrush x:Key="PressedBg" Color="#383c44"/>
    <!-- outlines are barely there: just enough to separate inputs from the panel they sit on -->
    <SolidColorBrush x:Key="Border" Color="#2d3037"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="Transparent"/>

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ececef"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#b8bbc4"/>
    <SolidColorBrush x:Key="TextMuted" Color="#868a95"/>
    <SolidColorBrush x:Key="TextFaint" Color="#5d616b"/>

    <!-- accent -->
    <SolidColorBrush x:Key="Accent" Color="#6ea5ff"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2a3d61"/>
    <SolidColorBrush x:Key="AccentSofter" Color="#222f48"/>
    <SolidColorBrush x:Key="AccentText" Color="#9cc0ff"/>

    <!-- meaning -->
    <SolidColorBrush x:Key="Danger" Color="#ff7a7a"/>
    <SolidColorBrush x:Key="DangerBg" Color="#3a2226"/>
    <SolidColorBrush x:Key="DangerBgHover" Color="#4a292e"/>
    <SolidColorBrush x:Key="Warn" Color="#e8b53a"/>
    <SolidColorBrush x:Key="WarnBg" Color="#2a2512"/>

    <!-- shape -->
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">999</CornerRadius>
    <CornerRadius x:Key="RadiusMenu">12</CornerRadius>

    <!-- the stock Fluent menu pieces read these, so every menu and context menu follows the theme -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#23252b"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2f323a"/>
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#23252b"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#2f323a"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#323640"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3a3f4a"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#ececef"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#ffffff"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#5d616b"/>
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#30343b"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#868a95"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#868a95"/>
  </Styles.Resources>

  <!-- ===== menus: rounded, padded, no frame ===== -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMenu}"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinWidth" Value="220"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMenu}"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Margin" Value="24,0,0,0"/>
  </Style>
  <Style Selector="Separator">
    <Setter Property="Margin" Value="8,5"/>
  </Style>

  <!-- ===== title bar ===== -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ChipBg}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#d9534f"/>
    <Setter Property="Foreground" Value="#ffffff"/>
  </Style>

  <!-- ===== segmented tabs: icons in a soft pill, the selected one lifted ===== -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{StaticResource CardBg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1"/>
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CardBgAlt}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBg}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBg}"/>
  </Style>
</Styles>
