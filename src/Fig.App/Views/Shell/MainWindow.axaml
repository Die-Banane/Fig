<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fig.App.ViewModels"
        xmlns:views="using:Fig.App.Views"
        xmlns:render="using:Fig.App.Rendering"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="Fig.App.Views.MainWindow"
        x:DataType="vm:AppViewModel"
        Icon="/Assets/avalonia-logo.ico"
        MinWidth="1100" MinHeight="700"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{StaticResource SurfaceBg}"
        Title="fig">

    <!-- key bindings are built from the shortcut table (ShortcutCatalog + the user's changes) in code -->

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <views:TitleBar Grid.Row="0"/>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
        <!-- the Preferences page sits over everything below the title bar -->
        <ContentControl Margin="0,46,0,0" Content="{Binding PreferencesPage}" IsVisible="{Binding IsPreferencesOpen}"/>
        <views:ToastHost DataContext="{Binding Toasts}"/>
        <!-- gives export access to the GPU (the render thread owns the context); one pixel, draws nothing -->
        <render:GpuJobHost HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <!-- the window has no frame of its own, so its edges are grips -->
        <Panel x:Name="ResizeGrips">
            <Border Height="5" VerticalAlignment="Top" Margin="10,0" Background="Transparent" Cursor="TopSide" WindowDecorationProperties.ElementRole="ResizeN"/>
            <Border Height="5" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" Cursor="BottomSide" WindowDecorationProperties.ElementRole="ResizeS"/>
            <Border Width="5" HorizontalAlignment="Left" Margin="0,10" Background="Transparent" Cursor="LeftSide" WindowDecorationProperties.ElementRole="ResizeW"/>
            <Border Width="5" HorizontalAlignment="Right" Margin="0,10" Background="Transparent" Cursor="RightSide" WindowDecorationProperties.ElementRole="ResizeE"/>
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" WindowDecorationProperties.ElementRole="ResizeNW"/>
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" WindowDecorationProperties.ElementRole="ResizeNE"/>
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" WindowDecorationProperties.ElementRole="ResizeSW"/>
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" WindowDecorationProperties.ElementRole="ResizeSE"/>
        </Panel>
    </Grid>

</Window>
