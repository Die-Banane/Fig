<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fig.App.ViewModels"
        x:Class="Fig.App.Views.BookmarkRangesDialog"
        x:DataType="vm:BookmarkRangesViewModel"
        Title="Create ranges from bookmarks"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#1D1E20">
    <StackPanel Margin="24" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Text="Create ranges from bookmarks" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Use timeline point markers as section boundaries." Foreground="#8A8A8A" FontSize="12"/>
        </StackPanel>

        <CheckBox IsChecked="{Binding IncludeSequenceBounds}" Content="Include sequence start and end"/>
        <TextBlock Text="Clip markers are not included." Foreground="#8A8A8A" FontSize="12"/>

        <Border Height="1" Background="#2B2D31"/>
        <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="13"/>

        <TextBlock IsVisible="{Binding !CanCreate}" Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                   Foreground="#8A8A8A" FontSize="12"/>
        <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlannedRangeRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding RangeText}" FontFamily="monospace" Foreground="#8A8A8A" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Range names and output file names can be edited next." Foreground="#8A8A8A" FontSize="12"/>
        <TextBlock Text="Your existing markers and ranges are kept." Foreground="#8A8A8A" FontSize="12"/>

        <Border Height="1" Background="#2B2D31"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="fig" Width="110" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
            <Button Classes="fig primary" MinWidth="140" Content="{Binding CreateText}" IsDefault="True"
                    IsEnabled="{Binding CanCreate}" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
