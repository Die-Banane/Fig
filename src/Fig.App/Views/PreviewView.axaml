<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Fig.App.ViewModels"
             xmlns:local="using:Fig.App.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
             x:Class="Fig.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">

    <UserControl.Styles>
        <Style Selector="Button.monitor-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#d4d4d6"/>
        </Style>
        <Style Selector="Button.monitor-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333336"/>
        </Style>
        <Style Selector="Button.monitor-play">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#2a4a7a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="Button.monitor-play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3568ad"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#111111" CornerRadius="4">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="#1c1c1e" Padding="12,8"
                    BorderBrush="#2a2a2b" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,*" MinHeight="38">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   Foreground="#d4d4d6" FontSize="12"
                                   FontFamily="monospace" VerticalAlignment="Center"/>
                        <local:StrokeIcon Icon="loader-circle" Width="13" Height="13"
                                          IsVisible="{Binding IsBuffering}"
                                          ToolTip.Tip="Buffering preview"
                                          IconBrush="#7db1ff"/>
                        <local:StrokeIcon Icon="circle-alert" Width="13" Height="13"
                                          IsVisible="{Binding HasPlaybackError}"
                                          ToolTip.Tip="Playback unavailable"
                                          IconBrush="#ff6b6b"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Classes="monitor-btn" Command="{Binding JumpToStartCommand}"
                                ToolTip.Tip="Jump to start">
                            <local:StrokeIcon Icon="skip-start" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding StepBackFrameCommand}"
                                ToolTip.Tip="Previous frame">
                            <local:StrokeIcon Icon="step-back" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="monitor-play" Command="{Binding TogglePlaybackCommand}"
                                ToolTip.Tip="Play / pause">
                            <local:StrokeIcon Icon="{Binding PlaybackIconKey}" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding StepForwardFrameCommand}"
                                ToolTip.Tip="Next frame">
                            <local:StrokeIcon Icon="step-forward" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding JumpToEndCommand}"
                                ToolTip.Tip="Jump to end">
                            <local:StrokeIcon Icon="skip-end" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="monitor-btn" Command="{Binding ToggleMonitorMuteCommand}"
                                ToolTip.Tip="Mute monitor audio">
                            <local:StrokeIcon Icon="{Binding MonitorAudioIconKey}" Width="15" Height="15"/>
                        </Button>
                        <Slider Minimum="0" Maximum="1" Value="{Binding MonitorVolume}"
                                Width="82" Height="24" VerticalAlignment="Center"
                                ToolTip.Tip="Monitor volume"/>
                        <ComboBox ItemsSource="{Binding PreviewScaleOptions}"
                                  SelectedItem="{Binding PreviewScale}"
                                  FontSize="11" Width="74" Height="26"
                                  ToolTip.Tip="Preview quality">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewScaleOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <local:StrokeIcon Icon="gauge" Width="14" Height="14"
                                          ToolTip.Tip="{Binding DecodeStatus}"
                                          IconBrush="#77777a"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="4" Background="#000000"
                    BorderBrush="#333333" BorderThickness="1"
                    ClipToBounds="True">
                <local:PreviewSurface x:Name="Surface"/>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
