<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Fig.App.ViewModels"
             xmlns:local="using:Fig.App.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Fig.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- one setting: what it is on the left, its control on the right -->
        <Style Selector="Grid.pref-row">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style Selector="TextBlock.pref-label">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.pref-note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,24,0"/>
        </Style>
        <Style Selector="Button.recording">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        </Style>
        <Style Selector="ListBox.pref-rail ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.pref-rail ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ChipBg}"/>
        </Style>
        <Style Selector="ListBox.pref-rail ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBg}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:GeneralPageViewModel">
            <StackPanel>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Autosave after"/>
                        <TextBlock Classes="pref-note" Text="Seconds to wait after an edit before the project is saved."/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Value="{Binding AutosaveSeconds}" Minimum="0.2" Maximum="30" Increment="0.1"
                                   FormatString="0.0 s" Width="120" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Ask before closing unsaved projects"/>
                        <TextBlock Classes="pref-note" Text="When off, closing a project saves it without asking."/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AskBeforeClosingUnsaved}" OnContent="" OffContent=""
                                  VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:EditingPageViewModel">
            <StackPanel>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Snap"/>
                        <TextBlock Classes="pref-note" Text="Clips snap to edges, markers and the playhead. Same as the Snap button on the timeline."/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Snap}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Snap distance"/>
                        <TextBlock Classes="pref-note" Text="How close, in pixels on screen, something has to be before it snaps."/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Value="{Binding SnapReachPx}" Minimum="2" Maximum="40" Increment="1"
                                   FormatString="0 px" Width="120" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Select linked clips together"/>
                        <TextBlock Classes="pref-note" Text="Selecting a clip also selects its linked audio or video. Same as the Link button."/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding LinkedSelection}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Undo steps"/>
                        <TextBlock Classes="pref-note" Text="How many edits can be undone. Applies to the next project you open."/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Value="{Binding UndoSteps}" Minimum="10" Maximum="1000" Increment="10"
                                   FormatString="0" Width="120" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:PlaybackPageViewModel">
            <StackPanel>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Audio scrubbing"/>
                        <TextBlock Classes="pref-note" Text="Hear the audio under the playhead while dragging or shuttling it."/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AudioScrub}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Loop playback"/>
                        <TextBlock Classes="pref-note" Text="Start again from the beginning when playback reaches the end."/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Loop}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ExportPageViewModel">
            <StackPanel>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Quality"/>
                        <TextBlock Classes="pref-note" Text="Where the export dialog's quality starts. Lower numbers are better quality and bigger files."/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Value="{Binding Quality}" Minimum="0" Maximum="51" Increment="1"
                                   FormatString="0" Width="120" VerticalAlignment="Center"/>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Export folder"/>
                        <TextBlock Classes="pref-note" Text="Where exports go by default. Leave empty to use your Videos folder."/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Folder}" PlaceholderText="Videos folder" Width="260"
                             VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:KeyboardPageViewModel">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Section}" IsVisible="{Binding ShowSection}" Classes="pref-note"
                                       FontWeight="SemiBold" Margin="0,14,0,8"/>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="pref-label" Text="{Binding Label}"/>
                                    <TextBlock Classes="pref-note" Text="{Binding Note}"
                                               IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="fig compact" MinWidth="130" Command="{Binding RecordCommand}"
                                        Content="{Binding ButtonText}" HorizontalContentAlignment="Center"
                                        Classes.recording="{Binding IsRecording}"
                                        ToolTip.Tip="Click, then press the new keys (Esc cancels)"/>
                                <Button Grid.Column="2" Classes="fig compact icon" Command="{Binding ClearCommand}"
                                        ToolTip.Tip="No shortcut" AutomationProperties.Name="Remove shortcut">
                                    <local:StrokeIcon Icon="x" Width="13" Height="13" IconBrush="{StaticResource TextMuted}"/>
                                </Button>
                                <Button Grid.Column="3" Classes="fig compact icon" Command="{Binding ResetCommand}"
                                        IsVisible="{Binding IsModified}"
                                        ToolTip.Tip="Back to the default shortcut" AutomationProperties.Name="Reset shortcut">
                                    <local:StrokeIcon Icon="rotate-ccw" Width="13" Height="13" IconBrush="{StaticResource TextMuted}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="vm:RenderingPageViewModel">
            <StackPanel>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Renderer"/>
                        <TextBlock Classes="pref-note" Text="{Binding Selected.Note}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="160"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RendererOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Graphics"/>
                        <TextBlock Classes="pref-note" Text="{Binding CanvasStatus}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="fig compact" Content="Check again" Command="{Binding RefreshCanvasStatusCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Classes="pref-note" Text="The preview switches straight away. An export uses the renderer chosen when it starts."/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:StoragePageViewModel">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StorageRow">
                            <Grid Classes="pref-row" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Classes="pref-label" Text="{Binding Label}"/>
                                    <TextBlock Classes="pref-note" Text="{Binding Note}"/>
                                    <TextBlock Classes="pref-note" Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="fig compact" Content="Open" Command="{Binding OpenCommand}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Classes="pref-row" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="pref-label" Text="Previews and proxies"/>
                        <TextBlock Classes="pref-note" Text="Thumbnails, filmstrips, waveforms and proxies. They are rebuilt when a project is opened; the open project's are kept."/>
                        <TextBlock Classes="pref-note" Text="{Binding CacheNote}"
                                   IsVisible="{Binding CacheNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CacheSize}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="fig compact" Content="Clear" Command="{Binding ClearCacheCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- dim the editor behind, the page itself a soft panel in the middle -->
    <Grid Background="#99000000">
        <Border Background="{StaticResource PanelBg}" CornerRadius="{StaticResource RadiusPanel}"
                Width="860" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
            <Grid ColumnDefinitions="220,*">

                <!-- sections -->
                <Border Background="{StaticResource SurfaceBg}" Padding="12,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preferences" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="10,0,0,14"/>
                        <ListBox Classes="pref-rail" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreferencePageViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <local:StrokeIcon Icon="{Binding Icon}" Width="16" Height="16"
                                                          IconBrush="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- the open section -->
                <DockPanel Grid.Column="1" Margin="28,18,20,20">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,22">
                        <TextBlock Text="{Binding SelectedPage.Title}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="fig compact" Content="Reset to defaults"
                                Command="{Binding SelectedPage.ResetToDefaultsCommand}" IsVisible="{Binding SelectedPage.CanReset}"/>
                        <Button Grid.Column="2" Classes="fig compact icon" Command="{Binding CloseCommand}"
                                ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close preferences">
                            <local:StrokeIcon Icon="x" Width="14" Height="14" IconBrush="{StaticResource TextSecondary}"/>
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding SelectedPage}"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
